<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.akka</groupId>
        <artifactId>akka-javasdk-parent</artifactId>
        <version>3.6.6</version>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>akka-sdd</artifactId>
    <version>1.1.14-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>akka-sdd</name>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <langchain4j.version>1.15.0</langchain4j.version>
        <!-- The parent pom still pins this to the ancient 2.22.2, whose
             bundled junit-platform-launcher is too old for the JUnit 5.14.4
             this SDK version pulls in (fails with "OutputDirectoryCreator
             not available" and silently discovers zero tests instead of
             failing the build). Override to a modern version. -->
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
  </properties>

    <!-- Patches CVEs flagged by the container scan in transitive dependencies
         pulled in by the Akka SDK itself (none of these are declared
         directly anywhere in this pom). akka-javasdk-parent's
         akkaRuntimeDependencyCheck enforcer rule rejects anything newer
         than what the Akka runtime itself bundles (it takes precedence at
         execution anyway), so only overrides that land exactly on or below
         the runtime's own pin are usable here.
         netty is pinned to 4.1.137.Final - exactly what the runtime already
         bundles, which happens to already be past both netty CVEs'
         affected ranges (<=4.1.136.Final / <=4.1.135.Final).
         jackson-core/jackson-databind and lz4-java are NOT overridden: the
         runtime itself still bundles their vulnerable versions (2.21.5 and
         1.11.1), so those three CVEs are upstream-blocked until Akka
         patches their own SDK - overriding them fails the enforcer. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ongres.scram</groupId>
                <artifactId>scram-common</artifactId>
                <version>3.4</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-buffer</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-dns</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-http</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-http2</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-codec-socks</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-common</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-handler</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-handler-proxy</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-resolver</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-resolver-dns</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-resolver-dns-classes-macos</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-resolver-dns-native-macos</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-classes-epoll</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-classes-kqueue</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-native-epoll</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-native-kqueue</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-transport-native-unix-common</artifactId>
                <version>4.1.137.Final</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
    <!-- Your dependencies go here -->
      <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mongodb-atlas</artifactId>
            <version>1.15.0-beta25</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-google-ai-gemini</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
    </dependencies>
</project>
